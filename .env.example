# Copy to .env and replace the placeholders before starting the app.
APP_ENV=development
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_MINUTES=720
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql+psycopg://postgres:YOUR_DATABASE_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
GROQ_API_KEY=Provide key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=40
TEMP_UPLOAD_DIR=./backend/uploads
DOCUMENT_RETENTION_HOURS=24
TESSERACT_CMD=tesseract
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
